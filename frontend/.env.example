# Endereço da API (Spring Boot), sem barra no fim. Copie para .env.local e ajuste.
# Em branco ou ausente, o site usa os dados de exemplo de src/data/roteirosExemplo.ts.
VITE_API_URL=http://localhost:8080

# Login do painel do ADM pelo Keycloak (docs/keycloak.md). Em branco ou ausente, o painel usa o login próprio da API.
# A API precisa aceitar os mesmos tokens: APP_KEYCLOAK_EMISSOR com o mesmo endereço.
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_CLIENTE=fb-cicloturismo-web
